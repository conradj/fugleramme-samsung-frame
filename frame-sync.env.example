# Copy to /etc/frame-sync.env and enter your TV's IP address or hostname.
# Keep this file to simple KEY=value assignments; no export or shell expansion.
TV_HOST=

# Address reachable from the VM host (publish the port if Fugleramme uses Docker).
FUGLERAMME_URL=http://127.0.0.1:8080

# Absolute paths, writable by the frame-sync service account.
FRAME_SYNC_STATE_DIR=/var/lib/frame-sync
TV_TOKEN_FILE=/var/lib/frame-sync/tv-token.txt

# Attempts to read Art Mode per run (positive integer).
FRAME_SYNC_RETRIES=3
